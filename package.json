{
  "name": "connect-sdk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "check": "oxlint --deny-warnings . && oxfmt --check .",
    "fix": "oxlint --fix --deny-warnings . && oxfmt --write .",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "prepare": "if [ -z \"$CI\" ] && command -v hk >/dev/null 2>&1; then hk install; fi",
    "test": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.14.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "npm@12.0.2"
}
