amends
  "package://github.com/mathematic-inc/toolconfig/releases/download/v2026.11.6/toolconfig@2026.11.6#/ToolConfig.pkl"

root = true

toolconfig {
  `extends` =
    List(new Repository {
      git = "https://github.com/mathematic-inc/toolconfig-config.git"
      rev = "fc76ddad46c14a7b7fe03bf117a92ede11ea0dfb"
      path = "profiles/org/.toolconfig.pkl"
    })
}

sections {
  ["*"] {
    oxlint {
      rules {
        ["typescript/prefer-readonly-parameter-types"] {
          "deny"
          new {
            allow =
              List(
                // Descriptors and plugin messages, which the library declares mutable.
                new Dynamic {
                  from = "package"
                  `package` = "@bufbuild/protobuf"
                  name =
                    List(
                      "CodeGeneratorRequest",
                      "CodeGeneratorResponse_File",
                      "DescFile",
                      "DescMethod",
                      "DescService",
                    )
                },
                // The plugin API passes a schema and a file sink, which have methods.
                new Dynamic {
                  from = "package"
                  `package` = "@bufbuild/protoplugin"
                  name = List("GeneratedFile", "Schema")
                },
                // The rule rejects the methods of the read-only collection types.
                new Dynamic {
                  from = "lib"
                  name = List("ReadonlyMap")
                },
              )
          }
        }
      }
    }
  }
  ["*.proto"] { buf { modules { new { path = "proto" } } } }
}
